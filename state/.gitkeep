    .addItem('Actualiser les jauges', 'refreshCountersFromMenu_')
    .addItem('Reconstruire le planning mensuel', 'rebuildPlanningFromMenu_')
    .addSeparator()
    .addItem('Activer les logs detailles', 'activerDebugVisites')
    .addItem('Desactiver les logs detailles', 'desactiverDebugVisites')
