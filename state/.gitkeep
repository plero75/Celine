}

function dateFromPublicSlotId_(slotId) {
  const match = String(slotId || '').trim().match(/^CR-(\d{4})-(\d{2})(\d{2})$/);
  if (!match) return null;
  return new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
}

function repairPublicSlotDatesFromIds_() {
  const table = getTable_(APP_CONFIG.SHEETS.PUBLIC_SLOTS);
  let repaired = 0;
  table.records.forEach(function(slot) {
    const slotId = value_(slot, 'ID_CRENEAU');
    const expectedDate = dateFromPublicSlotId_(slotId);
    if (!expectedDate) return;
    const current = formatDate_(value_(slot, 'Date'), 'yyyy-MM-dd');
    const expected = formatDate_(expectedDate, 'yyyy-MM-dd');
    if (current !== expected) {
      updateRecord_(APP_CONFIG.SHEETS.PUBLIC_SLOTS, 'ID_CRENEAU', slotId, {'Date': expectedDate});
      repaired++;
    }
  });
  if (repaired) {
    traceWarn_('repairPublicSlotDatesFromIds_', 'Dates de creneaux reparees depuis les IDs', {repaired: repaired});
  } else {
    traceDebug_('repairPublicSlotDatesFromIds_', 'Aucune date de creneau a reparer');
  }
  return repaired;
}

function getSlotAvailability_(slot, registrations) {
  registrations = registrations || getTable_(APP_CONFIG.SHEETS.REGISTRATIONS).records;
  const reservedStatuses = ['ConfirmÃ©e', 'Confirmee', 'PrÃ©sente', 'Presente', 'Place proposÃ©e', 'Place proposee'];
  const confirmed = registrations
    .filter(function(item) { return String(value_(item, 'ID_CRENEAU') || '').trim() === String(value_(slot, 'ID_CRENEAU') || '').trim(); })
    .filter(function(item) { return reservedStatuses.indexOf(String(value_(item, 'Statut') || '').trim()) !== -1; })
    .reduce(function(sum, item) { return sum + Number(value_(item, 'Total participants') || 0); }, 0);
  const capacity = Number(value_(slot, 'Places en ligne') || value_(slot, 'CapacitÃ©') || value_(slot, 'Capacite') || 0);
  return {confirmed: confirmed, capacity: capacity, remaining: Math.max(0, capacity - confirmed)};
}

function refreshAllPublicSlotCounters_() {
  traceInfo_('refreshAllPublicSlotCounters_', 'Actualisation des jauges');
  cleanGhostRowsForSheet_(APP_CONFIG.SHEETS.PUBLIC_SLOTS);
  const table = getTable_(APP_CONFIG.SHEETS.PUBLIC_SLOTS);
  const registrations = getTable_(APP_CONFIG.SHEETS.REGISTRATIONS).records;
  let processed = 0;

  table.records.forEach(function(slot) {
    const availability = getSlotAvailability_(slot, registrations);
    const status = String(value_(slot, 'Statut') || '').trim();
    const patch = {
      'Inscrits confirmes': availability.confirmed,
      'Places restantes': availability.remaining
    };
    if (availability.remaining <= 0 && ['Annule', 'Inscriptions closes', 'A confirmer'].indexOf(status) === -1) {
      patch.Statut = 'Complet';
    } else if (availability.remaining > 0 && status === 'Complet') {
      patch.Statut = 'Planifie';
    }
    updateRecord_(APP_CONFIG.SHEETS.PUBLIC_SLOTS, 'ID_CRENEAU', value_(slot, 'ID_CRENEAU'), patch);
    processed++;
  });
  traceInfo_('refreshAllPublicSlotCounters_', 'Jauges actualisees', {processed: processed});
  return processed;
}

function ensurePlanningSheet_() {
  const spreadsheet = getSpreadsheet_();
  let sheet = spreadsheet.getSheetByName(APP_CONFIG.SHEETS.PLANNING);
  if (!sheet) sheet = spreadsheet.insertSheet(APP_CONFIG.SHEETS.PLANNING);
  sheet.clear();
  sheet.getRange(1, 1).setValue('Planning mensuel des visites');
  sheet.getRange(2, 1, 1, 7).setValues([['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche']]);
  sheet.getRange(1, 1, 1, 7).merge().setBackground('#12324a').setFontColor('#ffffff').setFontWeight('bold').setFontSize(14);
  sheet.getRange(2, 1, 1, 7).setBackground('#c69d46').setFontColor('#ffffff').setFontWeight('bold');
  sheet.setFrozenRows(2);
  sheet.setColumnWidths(1, 7, 150);
  return sheet;
}

function rebuildMonthlyPlanningSheet(monthText) {
  const month = monthText || Utilities.formatDate(new Date(), APP_CONFIG.TIMEZONE, 'yyyy-MM');
  traceInfo_('rebuildMonthlyPlanningSheet', 'Reconstruction du planning mensuel', {month: month});
  const planning = getMonthlyPlanning(month);
  const sheet = ensurePlanningSheet_();
  const rows = [];
  planning.weeks.forEach(function(week) {
    rows.push(week.map(function(day) {
      if (!day) return '';
      const lines = [day.dayNumber];
      day.items.forEach(function(item) {
        lines.push(item.time + ' ' + item.label + ' - ' + item.status);
      });
      return lines.join('\n');
    }));
  });
  if (rows.length) {
    sheet.getRange(3, 1, rows.length, 7).setValues(rows).setWrap(true).setVerticalAlignment('top');
    sheet.setRowHeights(3, rows.length, 95);
  }
  return {ok: true, month: month, weeks: rows.length};
}

function getMonthlyPlanning(monthText) {
  const month = monthText || Utilities.formatDate(new Date(), APP_CONFIG.TIMEZONE, 'yyyy-MM');
  const parts = month.split('-').map(Number);
  const year = parts[0];
  const monthIndex = parts[1] - 1;
  const first = new Date(year, monthIndex, 1);
  const last = new Date(year, monthIndex + 1, 0);
  const slots = getTable_(APP_CONFIG.SHEETS.PUBLIC_SLOTS).records;
  const demands = getTable_(APP_CONFIG.SHEETS.DEMANDS).records;
  const groups = getTable_(APP_CONFIG.SHEETS.GROUPS).records;
  const itemsByDate = {};

  function addItem(dateValue, item) {
    const key = formatDate_(dateValue, 'yyyy-MM-dd');
    if (!key) return;
    if (!itemsByDate[key]) itemsByDate[key] = [];
    itemsByDate[key].push(item);
  }

  demands.forEach(function(demand) {
    addItem(value_(demand, 'Date souhaitÃ©e') || value_(demand, 'Date souhaitee'), {
      type: 'demande',
      id: value_(demand, 'ID_DEMANDE'),
      label: value_(demand, 'Ã‰vÃ©nement associÃ©') || value_(demand, 'Evenement associe') || value_(demand, 'Type demande') || value_(demand, 'ID_DEMANDE'),
      status: value_(demand, 'Statut') || 'Brouillon DMC',
      time: asDisplay_(demand, 'Heure debut fenetre') || '',
      color: STATUS_COLORS[value_(demand, 'Statut')] || '#e5e7eb'
    });
  });

  slots.forEach(function(slot) {
    addItem(value_(slot, 'Date'), {
      type: 'creneau',
      id: value_(slot, 'ID_CRENEAU'),
      label: 'Creneau public',
      status: value_(slot, 'Statut') || 'Planifie',
      time: asDisplay_(slot, 'Heure depart') || '',
      color: STATUS_COLORS[value_(slot, 'Statut')] || '#dbeafe',
      remaining: value_(slot, 'Places restantes')
    });
  });

  groups.forEach(function(group) {
    const linkedDemand = demands.find(function(demand) {
      return String(value_(demand, 'ID_DEMANDE')) === String(value_(group, 'ID_DEMANDE'));
    });
    addItem(value_(linkedDemand, 'Date souhaitÃ©e') || value_(linkedDemand, 'Date souhaitee'), {
      type: 'visite',
      id: value_(group, 'ID_GROUPE'),
      label: value_(group, 'Nom du groupe') || 'Visite groupe',
      status: value_(group, 'Statut opÃ©rationnel') || value_(group, 'Statut operationnel') || 'Planifie',
      time: asDisplay_(group, 'Heure depart') || asDisplay_(group, 'Heure prise en charge') || '',
      color: STATUS_COLORS[value_(group, 'Statut opÃ©rationnel') || value_(group, 'Statut operationnel')] || '#cffafe'
    });
  });

  const weeks = [];
  let cursor = new Date(first);
  const mondayOffset = (cursor.getDay() + 6) % 7;
  cursor.setDate(cursor.getDate() - mondayOffset);
  while (cursor <= last || weeks.length < 5) {
    const week = [];
    for (let i = 0; i < 7; i++) {
      const inMonth = cursor.getMonth() === monthIndex;
      const key = formatDate_(cursor, 'yyyy-MM-dd');
      week.push(inMonth ? {
        date: key,
        dayNumber: cursor.getDate(),
        items: (itemsByDate[key] || []).sort(function(a, b) { return String(a.time).localeCompare(String(b.time)); })
      } : null);
      cursor.setDate(cursor.getDate() + 1);
    }
    weeks.push(week);
    if (cursor > last && cursor.getDay() === 1) break;
  }
  return {month: month, weeks: weeks};
}

function getAdminPin_() {
  return PropertiesService.getScriptProperties().getProperty('ADMIN_PIN') || 'CHANGE-ME';
}

function loginAdmin(pin) {
  if (!pin || String(pin) !== String(getAdminPin_())) throw new Error('Code administrateur incorrect.');
  const token = Utilities.getUuid();
  CacheService.getScriptCache().put('admin:' + token, '1', APP_CONFIG.ADMIN_TOKEN_TTL_SECONDS);
  return {token: token, expiresIn: APP_CONFIG.ADMIN_TOKEN_TTL_SECONDS};
}

function requireAdmin_(token) {
  if (!token || CacheService.getScriptCache().get('admin:' + token) !== '1') {
    throw new Error('Session administrateur expiree ou non autorisee.');
  }
}

function getAdminData(token, filters) {
  requireAdmin_(token);
  const startedAt = new Date().getTime();
  filters = filters || {};
  cleanAllGhostRows_();
  repairPublicSlotDatesFromIds_();
  refreshAllPublicSlotCounters_();

  const month = filters.month || Utilities.formatDate(new Date(), APP_CONFIG.TIMEZONE, 'yyyy-MM');
  const demands = getTable_(APP_CONFIG.SHEETS.DEMANDS).records.map(formatDemandForClient_);
  const slots = getTable_(APP_CONFIG.SHEETS.PUBLIC_SLOTS).records.map(formatSlotForClient_);
  const groupRows = getTable_(APP_CONFIG.SHEETS.GROUPS).records.map(formatGroupForClient_);
  const visits = getGlobalVisitsForClient_(groupRows, slots);
  const b2b = getTable_(APP_CONFIG.SHEETS.B2B).records.map(formatB2BForClient_);
  const registrations = getTable_(APP_CONFIG.SHEETS.REGISTRATIONS).records;
  const planning = getMonthlyPlanning(month);

  const payload = {
    version: APP_CONFIG.VERSION,
    month: month,
    summary: {
      demandes: demands.length,
      visites: visits.length,
      creneaux: slots.length,
      inscriptions: registrations.length,
      alertes: slots.filter(function(slot) { return Number(slot['Places restantes'] || 0) <= 3; }).length
    },
    demands: demands.slice(0, 80),
    slots: slots.slice(0, 120),
    groups: visits.slice(0, 160),
    b2b: b2b.slice(0, 80),
    planning: planning
  };
  traceInfo_('getAdminData', 'Donnees admin chargees', {durationMs: new Date().getTime() - startedAt, month: month, summary: payload.summary});
  return payload;
}

function formatDemandForClient_(record) {
  return {
    ID_DEMANDE: value_(record, 'ID_DEMANDE'),
    Statut: value_(record, 'Statut') || '',
    Priorite: value_(record, 'PrioritÃ©') || value_(record, 'Priorite') || '',
    'Type demande': value_(record, 'Type demande') || '',
    'Evenement associe': value_(record, 'Ã‰vÃ©nement associÃ©') || value_(record, 'Evenement associe') || '',
    'Date souhaitee': formatDate_(value_(record, 'Date souhaitÃ©e') || value_(record, 'Date souhaitee')),
    'Heure debut fenetre': asDisplay_(record, 'Heure debut fenetre'),
    'PAX total': value_(record, 'PAX total') || '',
    'Responsable DMC': value_(record, 'Responsable DMC') || '',
    'Contact GTHP': value_(record, 'Contact GTHP') || '',
    Commentaires: value_(record, 'Commentaires') || ''
  };
}

function formatSlotForClient_(record) {
  return {
    ID_CRENEAU: value_(record, 'ID_CRENEAU'),
    ID_DEMANDE: value_(record, 'ID_DEMANDE') || '',
    Date: formatDate_(value_(record, 'Date')),
    'Heure depart': asDisplay_(record, 'Heure depart'),
    'Duree (min)': value_(record, 'DurÃ©e (min)') || value_(record, 'Duree (min)') || '',
    Capacite: value_(record, 'CapacitÃ©') || value_(record, 'Capacite') || '',
    'Places en ligne': value_(record, 'Places en ligne') || '',
    'Inscrits confirmes': value_(record, 'Inscrits confirmÃ©s') || value_(record, 'Inscrits confirmes') || 0,
    'Places restantes': value_(record, 'Places restantes') || '',
    Statut: value_(record, 'Statut') || '',
    Publication: value_(record, 'Publication') || '',
    'Point de rendez-vous': value_(record, 'Point de rendez-vous') || '',
    Consignes: value_(record, 'Consignes') || '',
    Guide: value_(record, 'Guide') || ''
  };
}

function formatGroupForClient_(record) {
  return {
    ID_GROUPE: value_(record, 'ID_GROUPE'),
    ID_DEMANDE: value_(record, 'ID_DEMANDE') || '',
    'Nom du groupe': value_(record, 'Nom du groupe') || '',
    Type: value_(record, 'Type') || '',
    'Effectif prevu': value_(record, 'Effectif prÃ©vu') || value_(record, 'Effectif prevu') || '',
    Guide: value_(record, 'Guide') || '',
    'Heure depart': asDisplay_(record, 'Heure depart'),
    'Statut operationnel': value_(record, 'Statut opÃ©rationnel') || value_(record, 'Statut operationnel') || '',
    Commentaires: value_(record, 'Commentaires') || ''
  };
}

function getGlobalVisitsForClient_(groupRows, slotRows) {
  const visits = [];
  (slotRows || []).forEach(function(slot) {
    visits.push({
      ID_GROUPE: slot.ID_CRENEAU,
      ID_DEMANDE: slot.ID_DEMANDE || '',
      'Nom du groupe': 'Depart public',
      Type: 'Creneau public',
      Date: slot.Date || '',
      'Effectif prevu': slot.Capacite || '',
      'Heure depart': slot['Heure depart'] || '',
      Guide: slot.Guide || '',
      'Statut operationnel': slot.Statut || '',
      Source: 'Creneau public',
      Publication: slot.Publication || '',
      'Places restantes': slot['Places restantes'] || ''
    });
  });
  (groupRows || []).forEach(function(group) {
    visits.push({
      ID_GROUPE: group.ID_GROUPE,
      ID_DEMANDE: group.ID_DEMANDE || '',
      'Nom du groupe': group['Nom du groupe'] || 'Groupe',
      Type: group.Type || 'Groupe',
      Date: group.Date || '',
      'Effectif prevu': group['Effectif prevu'] || '',
      'Heure depart': group['Heure depart'] || '',
      Guide: group.Guide || '',
      'Statut operationnel': group['Statut operationnel'] || '',
      Source: 'Groupe / rotation',
      Publication: '',
      'Places restantes': ''
    });
  });
  visits.sort(function(a, b) {
    return String(a.Date + ' ' + a['Heure depart']).localeCompare(String(b.Date + ' ' + b['Heure depart']));
  });
  return visits;
}

function formatB2BForClient_(record) {
  return {
    ID_B2B: value_(record, 'ID_B2B'),
    ID_DEMANDE: value_(record, 'ID_DEMANDE') || '',
    Client: value_(record, 'Client') || '',
    'Date prestation': formatDate_(value_(record, 'Date prestation')),
    'PAX vendu': value_(record, 'PAX vendu') || '',
    'Prix de vente HT': value_(record, 'Prix de vente HT') || '',
    'Cout total': value_(record, 'CoÃ»t total') || value_(record, 'Cout total') || '',
    'Marge EUR': value_(record, 'Marge â‚¬') || value_(record, 'Marge EUR') || '',
    'Statut devis': value_(record, 'Statut devis') || '',
    'Statut commande': value_(record, 'Statut commande') || ''
  };
}

function saveDemand(token, data) {
  requireAdmin_(token);
  data = normalizeClientPayload_(data);
  if (!data.ID_DEMANDE) data.ID_DEMANDE = makeId_('VIS');
  if (!data['Date creation'] && !data['Date crÃ©ation']) data['Date creation'] = new Date();
  if (!data.Statut) data.Statut = 'Brouillon DMC';
  const exists = getTable_(APP_CONFIG.SHEETS.DEMANDS).records.some(function(item) {
    return String(value_(item, 'ID_DEMANDE')) === String(data.ID_DEMANDE);
  });
  if (exists) updateRecord_(APP_CONFIG.SHEETS.DEMANDS, 'ID_DEMANDE', data.ID_DEMANDE, data);
  else appendRecord_(APP_CONFIG.SHEETS.DEMANDS, data);
  traceInfo_('saveDemand', exists ? 'Demande modifiee' : 'Demande creee', {id: data.ID_DEMANDE});
  rebuildMonthlyPlanningSheet();
  return {ok: true, id: data.ID_DEMANDE};
}

function savePublicSlot(token, data) {
  requireAdmin_(token);
  data = normalizeClientPayload_(data);
  if (!data.ID_CRENEAU) data.ID_CRENEAU = makeId_('CR');
  if (!data.Statut) data.Statut = 'Planifie';
  if (!data.Publication) data.Publication = 'Non publie';
  if (!data['Point de rendez-vous']) data['Point de rendez-vous'] = APP_CONFIG.DEFAULT_POINT;
  const exists = getTable_(APP_CONFIG.SHEETS.PUBLIC_SLOTS).records.some(function(item) {
    return String(value_(item, 'ID_CRENEAU')) === String(data.ID_CRENEAU);
  });
  if (exists) updateRecord_(APP_CONFIG.SHEETS.PUBLIC_SLOTS, 'ID_CRENEAU', data.ID_CRENEAU, data);
  else appendRecord_(APP_CONFIG.SHEETS.PUBLIC_SLOTS, data);
  traceInfo_('savePublicSlot', exists ? 'Creneau modifie' : 'Creneau cree', {id: data.ID_CRENEAU});
  refreshAllPublicSlotCounters_();
  rebuildMonthlyPlanningSheet();
  return {ok: true, id: data.ID_CRENEAU};
}

function normalizePublicSlotStatus_(status) {
  return normalizeHeader_(status);
}

function isPublicSlotPublished_(slot) {
  const publication = normalizeHeader_(value_(slot, 'Publication'));
  const status = normalizePublicSlotStatus_(value_(slot, 'Statut'));
  return publication === 'publie' && ['annule', 'annulee', 'inscriptionscloses'].indexOf(status) === -1;
}

function createPublicRegistration(slotId, data) {
  slotId = String(slotId || '').trim();
  data = data || {};
  if (!slotId) throw new Error('Creneau manquant.');

  repairPublicSlotDatesFromIds_();
  refreshAllPublicSlotCounters_();

  const slots = getTable_(APP_CONFIG.SHEETS.PUBLIC_SLOTS).records;
  const slot = slots.find(function(item) {
    return String(value_(item, 'ID_CRENEAU') || '').trim() === slotId;
  });
  if (!slot) throw new Error('Creneau introuvable.');
  if (!isPublicSlotPublished_(slot)) throw new Error('Ce creneau n est pas ouvert aux inscriptions.');

  const availability = getSlotAvailability_(slot);
  const adults = Math.max(0, Number(data.Adultes || data.adultes || 0));
  const children = Math.max(0, Number(data.Enfants || data.enfants || 0));
  const total = adults + children;
  if (!data.Nom && !data.nom) throw new Error('Nom obligatoire.');
  if (!data.Email && !data.email) throw new Error('Email obligatoire.');
  if (total <= 0) throw new Error('Indiquez au moins un participant.');
  if (total > availability.remaining) {
    throw new Error('Il ne reste que ' + availability.remaining + ' place(s) sur ce creneau.');
  }

  const reservationId = makeId_('RES');
  const qrToken = Utilities.getUuid();
  appendRecord_(APP_CONFIG.SHEETS.REGISTRATIONS, {
    'ID_RESERVATION': reservationId,
    'ID_CRENEAU': slotId,
    'Date inscription': new Date(),
    'Statut': 'Confirmee',
    'Nom': data.Nom || data.nom || '',
    'Prenom': data.Prenom || data.prenom || '',
    'Email': data.Email || data.email || '',
    'Telephone': data.Telephone || data.telephone || '',
    'Adultes': adults,
    'Enfants': children,
    'Total participants': total,
    'Origine': 'Web public',
    'QR token': qrToken,
    'Consentement RGPD': data.rgpd ? 'Oui' : '',
    'Commentaire visiteur': data.Commentaire || data.commentaire || '',
    'ID_DEMANDE': value_(slot, 'ID_DEMANDE') || ''
  });
  refreshAllPublicSlotCounters_();
  traceInfo_('createPublicRegistration', 'Inscription publique creee', {reservationId: reservationId, slotId: slotId, participants: total});
  return {
    ok: true,
    reservationId: reservationId,
    slotId: slotId,
    participants: total,
    message: 'Inscription confirmee.'
  };
}

function deleteDemand(token, id) {
  requireAdmin_(token);
  deleteRecord_(APP_CONFIG.SHEETS.DEMANDS, 'ID_DEMANDE', id);
  traceWarn_('deleteDemand', 'Demande supprimee', {id: id});
  rebuildMonthlyPlanningSheet();
  return {ok: true};
}

function deletePublicSlot(token, id) {
  requireAdmin_(token);
  deleteRecord_(APP_CONFIG.SHEETS.PUBLIC_SLOTS, 'ID_CRENEAU', id);
  traceWarn_('deletePublicSlot', 'Creneau supprime', {id: id});
  rebuildMonthlyPlanningSheet();
  return {ok: true};
}

