    .addItem('Afficher l URL du site', 'showWebAppUrl')
    .addItem('Instructions de deploiement', 'showDeploymentInstructions_')
    .addToUi();
}

function INSTALLER_VISITES_ENGHIEN() {
  traceInfo_('INSTALLER_VISITES_ENGHIEN', 'Installation demarree', {version: APP_CONFIG.VERSION});
  ensureStructure();
  seedReferenceData_();
  cleanAllGhostRows_();
  seedAugustPublicSlots_();
  repairPublicSlotDatesFromIds_();
  refreshAllPublicSlotCounters_();
  rebuildMonthlyPlanningSheet('2026-08');
  installVisitOpenTrigger_();

  let pin = PropertiesService.getScriptProperties().getProperty('ADMIN_PIN');
  if (!pin || pin === 'CHANGE-ME') {
    pin = 'ENGHIEN-' + Utilities.getUuid().replace(/-/g, '').slice(0, 8).toUpperCase();
    PropertiesService.getScriptProperties().setProperty('ADMIN_PIN', pin);
  }
  PropertiesService.getScriptProperties().setProperties({
    VISITES_INSTALLED: 'YES',
    VISITES_VERSION: APP_CONFIG.VERSION,
    VISITES_SPREADSHEET_ID: APP_CONFIG.SPREADSHEET_ID
  }, false);

  const dashboard = getSheet_(APP_CONFIG.SHEETS.DASHBOARD);
  dashboard.getRange('A3:C12').clearContent();
  dashboard.getRange('A3:C9').setValues([
    ['Installation', 'Terminee', ''],
    ['Version', APP_CONFIG.VERSION, ''],
    ['Code administrateur temporaire', pin, 'A changer apres installation'],
    ['Interface', 'Simplifiee', 'Demandes / visites / creneaux separes'],
    ['Planning mensuel', 'Actif', APP_CONFIG.SHEETS.PLANNING],
    ['Lignes fantomes', 'Nettoyees', 'Les lignes sans identifiant ne sont plus lues'],
    ['Etape suivante', 'Deployer comme application web', ScriptApp.getService().getUrl() || '']
  ]);
  dashboard.autoResizeColumns(1, 3);
  SpreadsheetApp.flush();
  traceInfo_('INSTALLER_VISITES_ENGHIEN', 'Installation terminee', {version: APP_CONFIG.VERSION, webAppUrl: ScriptApp.getService().getUrl() || ''});

  return {
    ok: true,
    pin: pin,
    version: APP_CONFIG.VERSION,
    spreadsheetId: APP_CONFIG.SPREADSHEET_ID,
    webAppUrl: ScriptApp.getService().getUrl() || ''
  };
}

function installVisitOpenTrigger_() {
  ScriptApp.getProjectTriggers()
    .filter(function(trigger) { return trigger.getHandlerFunction() === 'visitesOnOpen_'; })
    .forEach(function(trigger) { ScriptApp.deleteTrigger(trigger); });
  ScriptApp.newTrigger('visitesOnOpen_').forSpreadsheet(APP_CONFIG.SPREADSHEET_ID).onOpen().create();
}

function getPublicSlots() {
  repairPublicSlotDatesFromIds_();
  refreshAllPublicSlotCounters_();
  return getTable_(APP_CONFIG.SHEETS.PUBLIC_SLOTS).records
    .filter(isPublicSlotPublished_)
    .map(formatSlotForClient_);
}

function getAppBootstrap() {
  return {
    siteName: APP_CONFIG.SITE_NAME,
    version: APP_CONFIG.VERSION,
    publicSlots: getPublicSlots(),
    defaultPoint: APP_CONFIG.DEFAULT_POINT
  };
}

function doGet(e) {
  const view = e && e.parameter && e.parameter.view ? String(e.parameter.view).toLowerCase() : 'inscription';
  const html = getIndexHtml_().replace('%%VIEW%%', view);
  return HtmlService.createHtmlOutput(html)
    .setTitle(APP_CONFIG.SITE_NAME)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function getIndexHtml_() {
  return `<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Visites Enghien</title>
  <style>
    :root{--ink:#172033;--muted:#667085;--line:#d7dde7;--brand:#12324a;--gold:#c69d46;--bg:#f6f7f9}
    *{box-sizing:border-box} body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
    header{background:var(--brand);color:white;padding:16px 20px;display:flex;justify-content:space-between;gap:12px;align-items:center}
    h1{font-size:20px;margin:0} h2{font-size:18px;margin:0 0 12px} h3{font-size:15px;margin:0 0 8px}
    main{padding:18px;max-width:1280px;margin:auto}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
    button,.btn{border:1px solid var(--line);background:white;border-radius:6px;padding:9px 12px;cursor:pointer;font-weight:700}
    button.active,.primary{background:var(--brand);color:white;border-color:var(--brand)}.gold{background:var(--gold);color:white;border-color:var(--gold)}
    .danger{background:#b42318;color:white;border-color:#b42318}.grid{display:grid;gap:12px}.summary{grid-template-columns:repeat(5,minmax(120px,1fr))}
    .card{background:white;border:1px solid var(--line);border-radius:8px;padding:14px}.metric{font-size:26px;font-weight:800}.muted{color:var(--muted);font-size:13px}
    table{width:100%;border-collapse:collapse;background:white;border:1px solid var(--line)} th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left;font-size:13px;vertical-align:top}
    th{background:#eef2f6;font-weight:800}.toolbar{display:flex;justify-content:space-between;gap:10px;align-items:center;margin:14px 0;flex-wrap:wrap}
    input,select,textarea{width:100%;border:1px solid var(--line);border-radius:6px;padding:9px;font:inherit;background:white}
    .form-grid{display:grid;grid-template-columns:repeat(2,minmax(220px,1fr));gap:12px}.wide{grid-column:1/-1}
    .modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}
    .modal-box{background:white;border-radius:8px;max-width:760px;width:100%;max-height:90vh;overflow:auto;padding:18px}
    .calendar{display:grid;grid-template-columns:repeat(7,1fr);border:1px solid var(--line);background:white}.day-head{background:#eef2f6;font-weight:800;padding:8px;border-right:1px solid var(--line)}
    .day{min-height:118px;border-top:1px solid var(--line);border-right:1px solid var(--line);padding:8px}.day-num{font-weight:800;margin-bottom:6px}
    .pill{display:block;border-radius:5px;padding:5px 6px;margin:4px 0;font-size:12px;border:1px solid rgba(0,0,0,.08)}
    .legend{display:flex;gap:8px;flex-wrap:wrap}.legend span{padding:5px 7px;border-radius:5px;font-size:12px;border:1px solid var(--line)}
    .notice{padding:10px;border-radius:6px;background:#ecfdf3;border:1px solid #abefc6}.error{background:#fef3f2;border-color:#fecdca}
    @media(max-width:800px){.summary,.form-grid{grid-template-columns:1fr}.calendar{grid-template-columns:1fr}.day-head{display:none}.day{min-height:auto}}
  </style>
</head>
<body>
<header><h1>Visites Enghien</h1><div id="version"></div></header>
<main>
  <section id="public" style="display:none">
    <div class="toolbar"><h2>Inscriptions aux visites des ecuries</h2><span class="muted">Creneaux publies uniquement</span></div>
    <div id="publicMessage"></div>
    <div id="publicSlots" class="grid"></div>
  </section>
  <section id="login" class="card">
    <h2>Administration</h2>
    <div class="form-grid">
      <label>Code administrateur<input id="pin" type="password" autocomplete="current-password"></label>
      <div style="align-self:end"><button class="primary" onclick="login()">Entrer</button></div>
    </div>
    <p class="muted">La nouvelle interface separe les demandes, les visites et les creneaux publics.</p>
  </section>
  <section id="app" style="display:none">
    <div class="tabs">
      <button data-tab="planning" class="active" onclick="showTab('planning')">Planning mensuel</button>
      <button data-tab="demandes" onclick="showTab('demandes')">Demandes</button>
      <button data-tab="visites" onclick="showTab('visites')">Visites</button>
      <button data-tab="creneaux" onclick="showTab('creneaux')">Creneaux publics</button>
      <button data-tab="b2b" onclick="showTab('b2b')">B2B</button>
    </div>
    <div id="summary" class="grid summary"></div>
    <div id="content"></div>
  </section>
</main>
<div id="modal" class="modal"><div class="modal-box"><div id="modalContent"></div><div class="toolbar"><span></span><button onclick="closeModal()">Fermer</button></div></div></div>
<script>
const app={token:'',data:null,tab:'planning',month:new Date().toISOString().slice(0,7)};
const view='%%VIEW%%';
function qs(s,r){return (r||document).querySelector(s)} function qsa(s,r){return Array.from((r||document).querySelectorAll(s))}
function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function rpc(name,...args){return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[name](...args))}
function init(){if(view==='admin'||view==='gestion'){qs('#login').style.display='block';qs('#public').style.display='none'}else{qs('#login').style.display='none';qs('#public').style.display='block';loadPublic()}}
async function loadPublic(){try{const data=await rpc('getAppBootstrap');qs('#version').textContent=data.version;const slots=data.publicSlots||[];qs('#publicSlots').innerHTML=slots.length?slots.map(s=>'<div class="card"><h3>'+esc(s.Date)+' - '+esc(s['Heure depart']||'Horaire a confirmer')+'</h3><p><b>'+esc(s.Statut)+'</b> Â· '+esc(s['Places restantes'])+' place(s) restante(s)</p><p class="muted">'+esc(s['Point de rendez-vous']||data.defaultPoint||'')+'</p><button class="primary" onclick="openRegistration(\\''+esc(s.ID_CRENEAU)+'\\')">S inscrire</button></div>').join(''):'<div class="card">Aucun creneau publie pour le moment.</div>';app.publicSlots=slots}catch(e){showMessage(qs('#publicMessage'),e.message,'error')}}
function openRegistration(slotId){const slot=(app.publicSlots||[]).find(s=>s.ID_CRENEAU===slotId)||{};form('Inscription - '+(slot.Date||'')+' '+(slot['Heure depart']||''),[
 {key:'Nom',label:'Nom'},{key:'Prenom',label:'Prenom'},{key:'Email',label:'Email',type:'email'},{key:'Telephone',label:'Telephone'},
 {key:'Adultes',label:'Adultes',type:'number'},{key:'Enfants',label:'Enfants',type:'number'},{key:'Commentaire',label:'Commentaire',type:'textarea',wide:true}
],{Adultes:1,Enfants:0},async data=>{data.rgpd=true;const r=await rpc('createPublicRegistration',slotId,data);showMessage(qs('#publicMessage'),r.message+' Reference : '+r.reservationId,'success');await loadPublic()})}
function showMessage(el,msg,type){el.innerHTML='<div class="notice '+(type==='error'?'error':'')+'">'+esc(msg)+'</div>'}
async function login(){try{const r=await rpc('loginAdmin',qs('#pin').value);app.token=r.token;qs('#login').style.display='none';qs('#app').style.display='block';await load()}catch(e){alert(e.message)}}
async function load(){app.data=await rpc('getAdminData',app.token,{month:app.month});qs('#version').textContent=app.data.version;renderSummary();render()}
function renderSummary(){const s=app.data.summary;qs('#summary').innerHTML=[
 ['Demandes',s.demandes],['Visites',s.visites],['Creneaux',s.creneaux],['Inscriptions',s.inscriptions],['Alertes',s.alertes]
].map(x=>'<div class="card"><div class="muted">'+x[0]+'</div><div class="metric">'+x[1]+'</div></div>').join('')}
function showTab(tab){app.tab=tab;qsa('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));render()}
function render(){({planning:renderPlanning,demandes:renderDemandes,visites:renderVisites,creneaux:renderCreneaux,b2b:renderB2B}[app.tab]||renderPlanning)()}
function statusStyle(s){const colors={'Confirmee':'#bbf7d0','Planifie':'#bbf7d0','Ouvert':'#a7f3d0','Complet':'#fecaca','A confirmer':'#fde68a','Annulee':'#fecaca','Annule':'#fecaca','Realisee':'#d1d5db','Brouillon DMC':'#e5e7eb','Transmise au GTHP':'#bfdbfe','En cours etude':'#fde68a'};return 'background:'+(colors[s]||'#e5e7eb')}
function renderPlanning(){const p=app.data.planning;qs('#content').innerHTML='<div class="toolbar"><h2>Planning mensuel global</h2><div><input type="month" id="month" value="'+esc(app.month)+'" onchange="app.month=this.value;load()"></div></div><div class="legend"><span style="background:#e5e7eb">Demande</span><span style="background:#cffafe">Visite</span><span style="background:#dbeafe">Creneau</span><span style="background:#fecaca">Complet / annule</span></div><div class="calendar">'+['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'].map(d=>'<div class="day-head">'+d+'</div>').join('')+p.weeks.flat().map(day=>day?'<div class="day"><div class="day-num">'+day.dayNumber+'</div>'+day.items.map(i=>'<span class="pill" style="'+statusStyle(i.status)+'"><b>'+esc(i.time||'')+'</b> '+esc(i.label)+'<br><small>'+esc(i.type)+' - '+esc(i.status)+'</small></span>').join('')+'</div>':'<div class="day"></div>').join('')+'</div>'}
function table(headers,rows,actions){return '<table><thead><tr>'+headers.map(h=>'<th>'+esc(h.label)+'</th>').join('')+'<th></th></tr></thead><tbody>'+rows.map(r=>'<tr>'+headers.map(h=>'<td>'+esc(r[h.key])+'</td>').join('')+'<td>'+(actions?actions(r):'')+'</td></tr>').join('')+'</tbody></table>'}
function renderDemandes(){const h=[{key:'ID_DEMANDE',label:'ID'},{key:'Evenement associe',label:'Evenement'},{key:'Type demande',label:'Type'},{key:'Date souhaitee',label:'Date'},{key:'PAX total',label:'PAX'},{key:'Statut',label:'Statut'}];qs('#content').innerHTML='<div class="toolbar"><h2>Demandes</h2><button class="primary" onclick="editDemand({})">Nouvelle demande</button></div><div class="notice">Une demande est le besoin initial a valider : date, public, jauge, contraintes.</div>'+table(h,app.data.demands,r=>'<button onclick="editDemandById(\\''+esc(r.ID_DEMANDE)+'\\')">Modifier</button>')}
function renderVisites(){const h=[{key:'ID_GROUPE',label:'ID'},{key:'Date',label:'Date'},{key:'Nom du groupe',label:'Visite'},{key:'Type',label:'Type'},{key:'Effectif prevu',label:'PAX'},{key:'Heure depart',label:'Depart'},{key:'Places restantes',label:'Restantes'},{key:'Statut operationnel',label:'Statut'},{key:'Source',label:'Source'}];qs('#content').innerHTML='<div class="toolbar"><h2>Visites planifiees</h2></div><div class="notice">Cette vue regroupe les visites terrain et les creneaux publics. Un creneau public apparait donc ici comme visite planifiee, et aussi dans Creneaux publics pour la gestion des reservations.</div>'+table(h,app.data.groups)}
function renderCreneaux(){const h=[{key:'ID_CRENEAU',label:'ID'},{key:'Date',label:'Date'},{key:'Heure depart',label:'Depart'},{key:'Capacite',label:'Capacite'},{key:'Places restantes',label:'Restantes'},{key:'Statut',label:'Statut'},{key:'Publication',label:'Publication'}];qs('#content').innerHTML='<div class="toolbar"><h2>Creneaux publics</h2><button class="primary" onclick="editSlot({})">Nouveau creneau</button></div><div class="notice">Un creneau est un depart public reservable, rattache si besoin a une demande.</div>'+table(h,app.data.slots,r=>'<button onclick="editSlotById(\\''+esc(r.ID_CRENEAU)+'\\')">Modifier</button>')}
function renderB2B(){const h=[{key:'ID_B2B',label:'ID'},{key:'Client',label:'Client'},{key:'Date prestation',label:'Date'},{key:'PAX vendu',label:'PAX'},{key:'Prix de vente HT',label:'Vente HT'},{key:'Marge EUR',label:'Marge'},{key:'Statut devis',label:'Devis'}];qs('#content').innerHTML='<div class="toolbar"><h2>B2B prive</h2></div>'+table(h,app.data.b2b)}
function editDemandById(id){editDemand(app.data.demands.find(x=>x.ID_DEMANDE===id)||{})}
function editSlotById(id){editSlot(app.data.slots.find(x=>x.ID_CRENEAU===id)||{})}
function form(title,fields,data,onSave){qs('#modalContent').innerHTML='<h2>'+esc(title)+'</h2><form id="editForm"><div class="form-grid">'+fields.map(f=>'<label class="'+(f.wide?'wide':'')+'">'+esc(f.label)+' '+(f.type==='textarea'?'<textarea name="'+esc(f.key)+'">'+esc(data[f.key]||'')+'</textarea>':'<input name="'+esc(f.key)+'" type="'+(f.type||'text')+'" value="'+esc(data[f.key]||'')+'">')+'</label>').join('')+'</div><div class="toolbar"><button class="primary" type="submit">Enregistrer</button></div></form>';qs('#editForm').onsubmit=async e=>{e.preventDefault();const out={};qsa('[name]',e.target).forEach(x=>out[x.name]=x.value);await onSave(out);closeModal();if(app.token){await load()}};qs('#modal').classList.add('open')}
function editDemand(d){form('Demande',[
 {key:'ID_DEMANDE',label:'ID'},{key:'Evenement associe',label:'Evenement'},{key:'Type demande',label:'Type'},{key:'Date souhaitee',label:'Date',type:'date'},
 {key:'Heure debut fenetre',label:'Heure debut',type:'time'},{key:'PAX total',label:'PAX',type:'number'},{key:'Statut',label:'Statut'},{key:'Commentaires',label:'Commentaires',type:'textarea',wide:true}
],d,data=>rpc('saveDemand',app.token,data))}
function editSlot(d){form('Creneau public',[
 {key:'ID_CRENEAU',label:'ID'},{key:'ID_DEMANDE',label:'ID demande liee'},{key:'Date',label:'Date',type:'date'},{key:'Heure depart',label:'Heure depart',type:'time'},
 {key:'Duree (min)',label:'Duree',type:'number'},{key:'Capacite',label:'Capacite',type:'number'},{key:'Places en ligne',label:'Places en ligne',type:'number'},
 {key:'Statut',label:'Statut'},{key:'Publication',label:'Publication'},{key:'Point de rendez-vous',label:'Point de rendez-vous',wide:true},{key:'Consignes',label:'Consignes',type:'textarea',wide:true}
],d,data=>rpc('savePublicSlot',app.token,data))}
function closeModal(){qs('#modal').classList.remove('open')}
init();
</script>
</body>
</html>`;
}

