function normalizeHeader_(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-zA-Z0-9]/g, '')
    .toLowerCase();
}

function resolveHeaderIndex_(headers, headerName) {
  const target = normalizeHeader_(headerName);
  for (let i = 0; i < headers.length; i++) {
    if (normalizeHeader_(headers[i]) === target) return i;
  }
  return -1;
}

function value_(record, headerName) {
  if (!record) return '';
  if (Object.prototype.hasOwnProperty.call(record, headerName)) return record[headerName];
  return record[normalizeHeader_(headerName)] || '';
}

function display_(record, headerName) {
  if (!record) return '';
  if (Object.prototype.hasOwnProperty.call(record, headerName + '__display')) return record[headerName + '__display'];
  return record[normalizeHeader_(headerName) + '__display'] || value_(record, headerName) || '';
}

function trace_(level, source, message, data) {
  const debugEnabled = PropertiesService.getScriptProperties().getProperty('DEBUG_VISITES') === 'YES';
  if (level === 'DEBUG' && !debugEnabled) return;
  const text = '[VISITES][' + level + '][' + source + '] ' + message;
  if (data === undefined) {
    console.log(text);
    return;
  }
  console.log(text + ' | ' + JSON.stringify(sanitizeForLog_(data)));
}

function traceDebug_(source, message, data) {
  trace_('DEBUG', source, message, data);
}

function traceInfo_(source, message, data) {
  trace_('INFO', source, message, data);
}

function traceWarn_(source, message, data) {
  trace_('WARN', source, message, data);
}

function traceError_(source, error, data) {
  trace_('ERROR', source, error && error.stack ? error.stack : String(error), data);
}

function sanitizeForLog_(value) {
  if (value === null || value === undefined) return value;
  if (value instanceof Date) return Utilities.formatDate(value, APP_CONFIG.TIMEZONE, "yyyy-MM-dd'T'HH:mm:ss");
  if (Array.isArray(value)) return value.slice(0, 20).map(sanitizeForLog_);
  if (typeof value === 'object') {
    const out = {};
    Object.keys(value).slice(0, 40).forEach(function(key) {
      const lower = String(key).toLowerCase();
      out[key] = /email|telephone|phone|token|pin|secret|password/.test(lower) ? '[MASQUE]' : sanitizeForLog_(value[key]);
    });
    return out;
  }
  return value;
}

function getSpreadsheet_() {
  traceDebug_('getSpreadsheet_', 'Ouverture du classeur', {spreadsheetId: APP_CONFIG.SPREADSHEET_ID});
  return SpreadsheetApp.openById(APP_CONFIG.SPREADSHEET_ID);
}

function getSheet_(name) {
  const sheet = getSpreadsheet_().getSheetByName(name);
  if (!sheet) throw new Error('Onglet introuvable : ' + name);
  return sheet;
}

function getHeaders_(sheet, headerRow) {
  const row = headerRow || (sheet.getName() === APP_CONFIG.SHEETS.LOG ? 1 : 2);
  return sheet.getRange(row, 1, 1, Math.max(sheet.getLastColumn(), 1)).getDisplayValues()[0];
}

function getTable_(sheetName, options) {
  traceDebug_('getTable_', 'Lecture table', {sheetName: sheetName});
  options = options || {};
  const sheet = getSheet_(sheetName);
  const headerRow = options.headerRow || (sheetName === APP_CONFIG.SHEETS.LOG ? 1 : 2);
  const headers = getHeaders_(sheet, headerRow);
  const keyHeader = options.keyHeader || TABLE_KEYS[sheetName] || null;
  const keyIndex = keyHeader ? resolveHeaderIndex_(headers, keyHeader) : -1;
  const lastRow = sheet.getLastRow();
  const lastCol = Math.max(headers.length, sheet.getLastColumn());

  if (lastRow <= headerRow) {
    traceDebug_('getTable_', 'Table vide', {sheetName: sheetName});
    return {sheet: sheet, headers: headers, records: []};
  }

  const values = sheet.getRange(headerRow + 1, 1, lastRow - headerRow, lastCol).getValues();
  const displayValues = sheet.getRange(headerRow + 1, 1, lastRow - headerRow, lastCol).getDisplayValues();
  const records = [];

  values.forEach(function(row, index) {
    if (keyIndex >= 0 && !String(row[keyIndex] || '').trim()) return;
    const hasContent = row.some(function(value) {
      return value !== '' && value !== null;
    });
    if (!hasContent) return;

    const record = {_row: headerRow + 1 + index};
    headers.forEach(function(header, col) {
      if (!header) return;
      record[header] = row[col];
      record[header + '__display'] = displayValues[index][col];
      record[normalizeHeader_(header)] = row[col];
      record[normalizeHeader_(header) + '__display'] = displayValues[index][col];
    });
    records.push(record);
  });

  traceDebug_('getTable_', 'Lecture terminee', {sheetName: sheetName, records: records.length, lastRow: lastRow});
  return {sheet: sheet, headers: headers, records: records};
}

function appendRecord_(sheetName, data) {
  const table = getTable_(sheetName);
  const row = table.headers.map(function(header) {
    if (Object.prototype.hasOwnProperty.call(data || {}, header)) return data[header];
    const normalized = normalizeHeader_(header);
    const dataKey = Object.keys(data || {}).find(function(key) {
      return normalizeHeader_(key) === normalized;
    });
    return dataKey ? data[dataKey] : '';
  });
  table.sheet.appendRow(row);
  traceInfo_('appendRecord_', 'Ligne ajoutee', {sheetName: sheetName, row: table.sheet.getLastRow()});
  return table.sheet.getLastRow();
}

function updateRecord_(sheetName, keyHeader, keyValue, patch) {
  const normalizedKey = String(keyValue || '').trim();
  if (!normalizedKey) {
    traceWarn_('updateRecord_', 'Mise a jour refusee : identifiant vide', {sheetName: sheetName, keyHeader: keyHeader});
    return {ok: false, ignored: true, reason: 'Identifiant vide'};
  }

  const table = getTable_(sheetName, {keyHeader: keyHeader});
  const record = table.records.find(function(item) {
    return String(value_(item, keyHeader) || '').trim() === normalizedKey;
  });
  if (!record) {
    traceWarn_('updateRecord_', 'Enregistrement introuvable', {sheetName: sheetName, keyHeader: keyHeader, keyValue: normalizedKey});
    return {ok: false, ignored: true, reason: 'Enregistrement introuvable'};
  }

  const rowValues = table.sheet.getRange(record._row, 1, 1, table.headers.length).getValues()[0];
  Object.keys(patch || {}).forEach(function(header) {
    const index = resolveHeaderIndex_(table.headers, header);
    if (index >= 0) rowValues[index] = patch[header];
  });
  table.sheet.getRange(record._row, 1, 1, table.headers.length).setValues([rowValues]);
  traceInfo_('updateRecord_', 'Enregistrement mis a jour', {sheetName: sheetName, keyHeader: keyHeader, keyValue: normalizedKey, row: record._row, fields: Object.keys(patch || {})});
  return {ok: true, row: record._row};
}

function deleteRecord_(sheetName, keyHeader, keyValue) {
  const normalizedKey = String(keyValue || '').trim();
  if (!normalizedKey) throw new Error('Identifiant manquant.');
  const table = getTable_(sheetName, {keyHeader: keyHeader});
  const record = table.records.find(function(item) {
    return String(value_(item, keyHeader) || '').trim() === normalizedKey;
  });
  if (!record) throw new Error('Element introuvable : ' + normalizedKey);
  table.sheet.deleteRow(record._row);
  return true;
}

function cleanGhostRowsForSheet_(sheetName) {
  const keyHeader = TABLE_KEYS[sheetName];
  if (!keyHeader) return 0;
  const sheet = getSheet_(sheetName);
  const headerRow = sheetName === APP_CONFIG.SHEETS.LOG ? 1 : 2;
  const headers = getHeaders_(sheet, headerRow);
  const keyIndex = resolveHeaderIndex_(headers, keyHeader);
  if (keyIndex < 0 || sheet.getLastRow() <= headerRow) return 0;

  const lastCol = Math.max(sheet.getLastColumn(), headers.length);
  const values = sheet.getRange(headerRow + 1, 1, sheet.getLastRow() - headerRow, lastCol).getValues();
  const rowsToClear = [];

  values.forEach(function(row, index) {
    const hasContent = row.some(function(value) {
      return value !== '' && value !== null;
    });
    const hasKey = String(row[keyIndex] || '').trim() !== '';
    if (hasContent && !hasKey) rowsToClear.push(headerRow + 1 + index);
  });

  rowsToClear.forEach(function(rowNumber) {
    sheet.getRange(rowNumber, 1, 1, lastCol).clearContent();
  });
  if (rowsToClear.length) {
    traceWarn_('cleanGhostRowsForSheet_', 'Lignes fantomes videes', {sheetName: sheetName, rows: rowsToClear});
  } else {
    traceDebug_('cleanGhostRowsForSheet_', 'Aucune ligne fantome', {sheetName: sheetName});
  }
  return rowsToClear.length;
}

function cleanAllGhostRows_() {
  const report = {};
  Object.keys(TABLE_KEYS).forEach(function(sheetName) {
    report[sheetName] = cleanGhostRowsForSheet_(sheetName);
  });
  traceInfo_('cleanAllGhostRows_', 'Nettoyage termine', report);
  return report;
}

function makeId_(prefix) {
  return prefix + '-' + Utilities.formatDate(new Date(), APP_CONFIG.TIMEZONE, 'yyyyMMdd') + '-' + Utilities.getUuid().slice(0, 8).toUpperCase();
}

function normalizeDate_(value) {
  if (value instanceof Date && !isNaN(value)) return value;
  if (!value) return null;
  const parsed = new Date(value);
  return isNaN(parsed) ? null : parsed;
}

function formatDate_(value, pattern) {
  const date = normalizeDate_(value);
  return date ? Utilities.formatDate(date, APP_CONFIG.TIMEZONE, pattern || 'yyyy-MM-dd') : '';
}

function parseLocalDate_(value) {
  if (value instanceof Date && !isNaN(value)) return value;
  const text = String(value || '').trim();
  const match = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return value || '';
  return new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
}

function normalizeClientPayload_(data) {
  data = data || {};
  [
    'Date creation','Date crÃ©ation','Date souhaitee','Date souhaitÃ©e','Date','Date prestation',
    'Ouverture inscriptions','Cloture inscriptions','ClÃ´ture inscriptions'
  ].forEach(function(header) {
    if (Object.prototype.hasOwnProperty.call(data, header)) data[header] = parseLocalDate_(data[header]);
  });
  return data;
}

function asDisplay_(record, key) {
  return display_(record, key);
}

function ensureStructure() {
  traceInfo_('ensureStructure', 'Verification de la structure');
  const spreadsheet = getSpreadsheet_();
  Object.keys(REQUIRED_HEADERS).forEach(function(sheetName) {
    ensureSheetWithHeaders_(spreadsheet, sheetName, REQUIRED_HEADERS[sheetName], 2);
  });
  ensureSheetWithHeaders_(spreadsheet, APP_CONFIG.SHEETS.LOG, [
    'Horodatage','Utilisateur','Action','ID_DEMANDE','ID_OBJET','Ancienne valeur','Nouvelle valeur',
    'Commentaire','Source','Notification envoyee ?','Destinataire','Resultat','Detail erreur','Version'
  ], 1);
  ensureSheetWithHeaders_(spreadsheet, APP_CONFIG.SHEETS.REFERENCES, [
    'Categorie','Valeur','Code','Actif ?','Ordre','Detail','Cout HT','Duree min','Capacite','Site',
    'Telephone','Email','Adresse','Commentaires','Date MAJ','Auteur'
  ], 2);
  ensureSheetWithHeaders_(spreadsheet, APP_CONFIG.SHEETS.DASHBOARD, ['Indicateur','Valeur','Detail'], 2);
  ensurePlanningSheet_();
  formatVisitSheets_();
  traceInfo_('ensureStructure', 'Structure verifiee');
  return {ok: true, message: 'Structure verifiee et mise en forme.'};
}

function ensureSheetWithHeaders_(spreadsheet, sheetName, headers, headerRow) {
  const row = headerRow || 2;
  let sheet = spreadsheet.getSheetByName(sheetName);
  if (!sheet) sheet = spreadsheet.insertSheet(sheetName);
  if (sheet.getMaxColumns() < headers.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), headers.length - sheet.getMaxColumns());
  if (row > 1 && !sheet.getRange(1, 1).getValue()) sheet.getRange(1, 1).setValue(sheetName.replace(/_/g, ' '));

  const existing = sheet.getRange(row, 1, 1, Math.max(sheet.getLastColumn(), headers.length)).getDisplayValues()[0];
  if (!existing[0]) {
    sheet.getRange(row, 1, 1, headers.length).setValues([headers]);
  } else {
    headers.forEach(function(header, index) {
      if (!existing[index]) sheet.getRange(row, index + 1).setValue(header);
    });
  }
  sheet.setFrozenRows(row);
  return sheet;
}

function formatVisitSheets_() {
  const spreadsheet = getSpreadsheet_();
  Object.keys(APP_CONFIG.SHEETS).forEach(function(key) {
    const name = APP_CONFIG.SHEETS[key];
    const sheet = spreadsheet.getSheetByName(name);
    if (!sheet) return;
    const headerRow = name === APP_CONFIG.SHEETS.LOG ? 1 : 2;
    const lastCol = Math.max(sheet.getLastColumn(), 1);
    if (headerRow === 2) {
      sheet.getRange(1, 1, 1, lastCol).setBackground('#12324a').setFontColor('#ffffff').setFontWeight('bold').setFontSize(13);
    }
    sheet.getRange(headerRow, 1, 1, lastCol).setBackground('#c69d46').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);
    sheet.autoResizeColumns(1, Math.min(lastCol, 12));
  });
}

